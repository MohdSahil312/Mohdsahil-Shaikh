{%- comment -%}
  Loomhaus — Announcement bar
  Each "Message" block is one announcement. On desktop they sit in a row with a
  ✦ between them; on mobile only the first message is shown (as in Figma).
{%- endcomment -%}
{{ 'lh-announcement-bar.css' | asset_url | stylesheet_tag }}

<div class="lh lh-announce" role="region" aria-label="Announcements">
  {%- for block in section.blocks -%}
    {%- unless forloop.first -%}
      <span class="lh-announce__sep" aria-hidden="true">✦</span>
    {%- endunless -%}
    <p class="lh-announce__item{% unless forloop.first %} lh-announce__item--extra{% endunless %}" {{ block.shopify_attributes }}>
      {%- if block.settings.link != blank -%}
        <a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>
      {%- else -%}
        {{ block.settings.text | escape }}
      {%- endif -%}
    </p>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "LH Announcement bar",
  "class": "lh-section-announce",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on orders over ₹999" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "LH Announcement bar",
      "blocks": [
        { "type": "message", "settings": { "text": "Free shipping on orders over ₹999" } },
        { "type": "message", "settings": { "text": "Use code LOOM10 for 10% off your first order" } }
      ]
    }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
