{%- comment -%}
  Loomhaus — Shop the look (product grid)
  Up to six "Tile" blocks. Each tile picks a product in the customizer; the
  tile image is the product's featured image unless a custom image is set.
  The "+" hotspot position is set per tile (separately for desktop and mobile)
  and opens the quick view, whose data is rendered next to the button.
{%- endcomment -%}
{{ 'lh-shop-the-look.css' | asset_url | stylesheet_tag }}

<section class="lh lh-look" aria-labelledby="LhLookHeading-{{ section.id }}">
  <div class="lh-wrap lh-look__inner">
    <div class="lh-look__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="lh-look__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 id="LhLookHeading-{{ section.id }}" class="lh-look__heading lh-display">
          {{- section.settings.heading | escape -}}
        </h2>
      </div>
      {%- if section.settings.helper != blank -%}
        <p class="lh-look__helper">{{ section.settings.helper | escape }}</p>
      {%- endif -%}
    </div>

    <div class="lh-look__tiles">
      {%- for block in section.blocks -%}
        {%- liquid
          assign product = block.settings.product
          assign tile_image = block.settings.image | default: product.featured_image
          assign data_id = 'LhQvData-' | append: block.id
        -%}
        <article
          class="lh-look__tile"
          style="--x: {{ block.settings.x }}%; --y: {{ block.settings.y }}%; --mx: {{ block.settings.mobile_x }}%; --my: {{ block.settings.mobile_y }}%;"
          {{ block.shopify_attributes }}
        >
          {%- if tile_image != blank -%}
            {{
              tile_image
              | image_url: width: 900
              | image_tag:
                class: 'lh-look__image',
                widths: '360, 480, 640, 800, 900',
                sizes: '(min-width: 1100px) 400px, (min-width: 768px) 31vw, 47vw',
                loading: 'lazy',
                alt: product.title
            }}
          {%- else -%}
            {{ 'product-apparel-1' | placeholder_svg_tag: 'lh-look__image lh-look__image--placeholder' }}
          {%- endif -%}

          {%- if product != blank -%}
            <button
              type="button"
              class="lh-look__hotspot"
              data-lh-quick-view="{{ data_id }}"
              aria-haspopup="dialog"
              aria-label="Quick view: {{ product.title | escape }}"
            >
              {%- render 'lh-icon', icon: 'plus' -%}
            </button>
            {%- render 'lh-product-json', product: product, id: data_id -%}

            <a href="{{ product.url }}" class="lh-look__label">
              <span class="lh-look__label-name">{{ product.title | escape }}</span>
              <span class="lh-look__label-price">{{ product.selected_or_first_available_variant.price | money }}</span>
            </a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LH Shop the look",
  "class": "lh-section-look",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "SHOP THE LOOK" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loomhaus in the wild" },
    { "type": "text", "id": "helper", "label": "Helper text", "default": "Tap the + on any look to shop it." }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "image_picker", "id": "image", "label": "Custom image", "info": "Optional. Uses the product's featured image when empty." },
        { "type": "header", "content": "Hotspot position (desktop)" },
        { "type": "range", "id": "x", "label": "From left", "min": 0, "max": 92, "step": 1, "unit": "%", "default": 48 },
        { "type": "range", "id": "y", "label": "From top", "min": 0, "max": 92, "step": 1, "unit": "%", "default": 27 },
        { "type": "header", "content": "Hotspot position (mobile)" },
        { "type": "range", "id": "mobile_x", "label": "From left", "min": 0, "max": 85, "step": 1, "unit": "%", "default": 44 },
        { "type": "range", "id": "mobile_y", "label": "From top", "min": 0, "max": 88, "step": 1, "unit": "%", "default": 24 }
      ]
    }
  ],
  "presets": [
    {
      "name": "LH Shop the look",
      "blocks": [{ "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }]
    }
  ]
}
{% endschema %}
