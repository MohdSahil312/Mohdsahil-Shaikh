{%- comment -%}
  Loomhaus — compact product data for the quick view.
  Rendered as <script type="application/json"> next to each hotspot so the popup
  opens instantly without an extra request. Prices are in cents (formatted in JS
  with the store money format). Swatch colours come from the "Colour swatch"
  metaobjects, looked up by the option value's handle (black, white, ...).

  Usage: {% render 'lh-product-json', product: product, id: 'LhQv-123' %}
{%- endcomment -%}
<script type="application/json" id="{{ id }}">
  {
    "id": {{ product.id | json }},
    "title": {{ product.title | json }},
    "url": {{ product.url | json }},
    "description": {{ product.description | strip_html | strip | json }},
    "image": {{ product.featured_image | image_url: width: 720 | json }},
    "options": [
      {%- for option in product.options_with_values -%}
        {
          "name": {{ option.name | json }},
          "values": [
            {%- for value in option.values -%}
              {%- liquid
                assign value_name = value.name | default: value
                assign swatch_handle = value_name | handleize
                assign swatch_hex = shop.metaobjects.colour_swatch[swatch_handle].color.value | append: ''
              -%}
              { "name": {{ value_name | json }}, "swatch": {{ swatch_hex | json }} }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ],
    "variants": [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id }},
          "options": {{ variant.options | json }},
          "price": {{ variant.price }},
          "available": {{ variant.available | json }},
          "image": {{ variant.featured_image | default: product.featured_image | image_url: width: 720 | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>
